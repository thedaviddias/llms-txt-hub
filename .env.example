# =============================================================================
# SHARED MONOREPO ENVIRONMENT VARIABLES - EXAMPLE
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local or any file containing real secrets to version control

# -----------------------------------------------------------------------------
# 🚩 FEATURE FLAGS
# -----------------------------------------------------------------------------
FLAGS_SECRET="your_feature_flags_secret_key_here"

# -----------------------------------------------------------------------------
# 🐙 GITHUB INTEGRATION
# -----------------------------------------------------------------------------
# Personal Access Token for GitHub API access
# Create at: https://github.com/settings/tokens
# Scopes needed: repo, user, read:org
GITHUB_TOKEN="github_pat_your_token_here"

# GitHub OAuth App credentials
# Create at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# -----------------------------------------------------------------------------
# 📊 MONITORING & ANALYTICS
# -----------------------------------------------------------------------------
# Sentry error tracking and performance monitoring
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_dsn_here"
SENTRY_AUTH_TOKEN="your_sentry_auth_token_here"
SENTRY_ORG="your_sentry_org_here"
SENTRY_PROJECT="your_sentry_project_here"

# -----------------------------------------------------------------------------
# 📡 EXTERNAL SERVICES
# -----------------------------------------------------------------------------
# RSS feed for content aggregation (optional)
RSS_FEED_URL="https://your-rss-feed-url.com/feed.xml"

# Google Web Risk credential for server-side submission reputation checks (optional)
GOOGLE_WEB_RISK_API_KEY="your_google_web_risk_api_key_here"

# HMAC secret used to sign automatic-publication assessments (optional, 32+ characters)
SUBMISSION_ASSESSMENT_SIGNING_SECRET="replace_with_at_least_32_random_characters"

# Safe default; use shadow or enabled only after production trust checks are configured
SUBMISSION_AUTOPUBLISH_MODE="disabled"
